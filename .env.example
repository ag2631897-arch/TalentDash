# ──── DATABASE ────────────────────────────────────────────────
DATABASE_URL=postgresql://user:pass@ep-xxx.neon.tech/neondb?sslmode=require
DIRECT_URL=postgresql://user:pass@ep-xxx.neon.tech/neondb?sslmode=require
# Note: DIRECT_URL used by Prisma migrate (bypasses connection pooler)

# ──── AI / LLM ────────────────────────────────────────────────
GROQ_API_KEY=gsk_...

# ──── REDIS / JOB QUEUE ───────────────────────────────────────
UPSTASH_REDIS_URL=https://xxx.upstash.io
UPSTASH_REDIS_TOKEN=AXxx...

# ──── CLOUDFLARE ──────────────────────────────────────────────
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_ANON_KEY=eyJ...

# ──── APP CONFIG ──────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
INR_TO_USD_RATE=0.012
SCRAPER_RATE_LIMIT_MS_MIN=1500
SCRAPER_RATE_LIMIT_MS_MAX=4000
LLM_BATCH_SIZE=10
CONFIDENCE_SCORE_MIN_STORE=0.4
DUPLICATE_WINDOW_HOURS=48
DUPLICATE_SALARY_TOLERANCE=0.10

# ──── ANALYTICS ───────────────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=phc_...
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
